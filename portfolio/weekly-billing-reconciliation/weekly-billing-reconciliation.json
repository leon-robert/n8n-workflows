    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst projected = rows.map((r, i) => ({ x: i, y: r['Projected Revenue (EUR)'] })).filter(p => p.y !== '' && p.y !== undefined);\n\nconst n = projected.length;\nconst sumX = projected.reduce((s, p) => s + p.x, 0);\nconst sumY = projected.reduce((s, p) => s + p.y, 0);\nconst sumXY = projected.reduce((s, p) => s + p.x * p.y, 0);\nconst sumXX = projected.reduce((s, p) => s + p.x * p.x, 0);\nconst slope = (n * sumXY - sumX * sumY) / (n * sumXX - sumX * sumX);\nconst intercept = (sumY - slope * sumX) / n;\nconst suggestion = Math.round(intercept + slope * rows.length);\n\nconst historyText = rows.map(r =>\n  `${r.Week}: projected €${r['Projected Revenue (EUR)']}, actual ${r['Actual Revenue (EUR)'] ? '€' + r['Actual Revenue (EUR)'] : '—'}`\n).join('\\n');\n\nreturn [{ json: { suggestion, historyText } }];"
      },
