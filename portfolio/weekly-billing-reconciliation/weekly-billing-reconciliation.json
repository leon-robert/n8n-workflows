    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst counts = {};\nconst output = [];\nconst seenForRevenue = new Set();\n\nfor (const item of items) {\n  counts[item.json.match_key] = (counts[item.json.match_key] || 0) + 1;\n}\n\nfor(const item of items)\n{ const d = item.json;\n  let exception = null;\n  if (counts[d.match_key] > 1) {\n    exception = 'duplicate';\n  }else if (d['Invoice Status'] === 'Refunded') {\n    exception = 'refunded';\n  }else if (d['Invoice Status'] !== undefined && d.fields['Deal Status'] === \"Open\") {\n    exception = 'billing_error';\n  }else if (d['Invoice Amount (EUR)'] !== undefined && d.fields['Deal Value (EUR)'] !== d['Invoice Amount (EUR)']) {\n    exception = 'mismatch';\n  }else if (d['Invoice Status'] !== undefined && d.property_work_completed === false) {\n    exception = 'billed_without_delivery';\n  }else if (d.fields['Close Date'] === undefined) {\n    exception = 'incomplete_record';\n  }else if (d.fields['Deal Status'] === \"Closed Won\" && d['Invoice Status'] === undefined) {\n    exception = 'leak';\n  }else if (d.fields['Deal Status'] === \"Closed Lost\" || d.fields['Deal Status'] === \"Open\") {\n  exception = 'control';\n  }else\n  {\n    exception = 'clean';\n  }\n\noutput.push({ json: { ...d, exception } }); \n}\n\nreturn output;"
      },
