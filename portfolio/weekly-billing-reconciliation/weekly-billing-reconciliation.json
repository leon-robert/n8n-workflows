    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst summary = { week: items[0]?.json.week || '', total_clients: items.length, flagged: [] };\nlet totalInvoiced = 0;\nconst seenForRevenue = new Set();\n\nfor (const item of items) {\n  const d = item.json;\n  const client = d.fields ? d.fields['Client Name'] : d['Client Name'];\n\n  if (d.exception !== 'clean' && d.exception !== 'control') {\n    summary.flagged.push({ client, exception: d.exception });\n  }\n  if (d['Invoice Amount (EUR)'] !== undefined && d.exception !== 'refunded' && !seenForRevenue.has(d.match_key)) {\n    totalInvoiced += d['Invoice Amount (EUR)'];\n    seenForRevenue.add(d.match_key);\n  }\n}\n\nsummary.total_invoiced = totalInvoiced;\nsummary.status_note = summary.flagged.length === 0\n  ? 'All clear this week.'\n  : `${summary.flagged.length} item(s) need review: ` + summary.flagged.map(f => `${f.client} (${f.exception})`).join(', ');\n\nreturn [{ json: summary }];"
      },
