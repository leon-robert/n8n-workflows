    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst ip = $input.item.json.headers['x-forwarded-for'];\nconst limit = 7;\nconst windowMs = 60000;\nconst now = Date.now();\n\nif (staticData.requestLog === undefined) {\n  staticData.requestLog = {};\n}\n\nif (staticData.requestLog[ip] === undefined) {\n  staticData.requestLog[ip] = [];\n}\n\nstaticData.requestLog[ip] = staticData.requestLog[ip].filter(function (timestamp) {\n  return timestamp > now - windowMs;\n});\n\nstaticData.requestLog[ip].push(now);\n\nconst isRateLimited = staticData.requestLog[ip].length > limit;\n\nreturn [{\n  json: {\n    ip: ip,\n    count: staticData.requestLog[ip].length,\n    rateLimited: isRateLimited\n  }\n}];"
      },
