        "mode": "runOnceForEachItem",
        "jsCode": "let dataValid = true;\nlet reason;\nlet data = null;\n\nfunction sanitize(text) {\n  let clean = text.replace(/<[^>]*>/g, \"\");\n  clean = clean.replace(/['\";]/g, \"\");\n  return clean;\n}\n\n// malformed check first — gate everything else\nif (typeof $('Webhook').item.json.body !== \"object\" || $('Webhook').item.json.body === null) {\n  dataValid = false;\n  reason = \"Malformed JSON\";\n} else {\n  const body = $('Webhook').item.json.body;\n\n  if (body.name === undefined || body.email === undefined || body.message === undefined) {\n    dataValid = false;\n    reason = \"One or more items are missing from JSON\";\n  } else if (body.name === \"\" || body.email === \"\" || body.message === \"\") {\n    dataValid = false;\n    reason = \"One or more items are empty\";\n  } else if (body.name === null || body.email === null || body.message === null) {\n    dataValid = false;\n    reason = \"One or more items are null\";\n  } else {\n    data = {\n      name: sanitize(body.name),\n      email: sanitize(body.email),\n      message: sanitize(body.message)\n    };\n  }\n}\n\nreturn sanitized_response = {\n  dataValid: dataValid,\n  reason: reason,\n  data: data\n};"
      },
